{
  "manifest_version": 3,
  "name": "AI_Trans",
  "version": "0.1.0",
  "description": "Real-time video subtitle translation for YouTube (MVP M1)",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "runtime/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["runtime/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI_Trans"
  }
}
